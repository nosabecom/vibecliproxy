    "test": "node --test test/*.test.ts",
    "test:ui": "node scripts/test-ui.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "web-push": "^4.0.0"
  }
}
