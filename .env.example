HOST=127.0.0.1
PORT=8320
PUBLIC_ORIGIN=http://127.0.0.1:8320
BASE_PATH=/cliproxy
DATA_PATH=.data/hub.db
ADMIN_PASSWORD_HASH=
CLIPROXY_URL=http://127.0.0.1:8317
CLIPROXY_API_KEY=private-cliproxy-inference-key
CLIPROXY_MANAGEMENT_KEY=private-cliproxy-management-key
CLIPROXY_BINARY=./bin/cli-proxy-api
OAUTH_DIRECTORY=.data/onboarding
OPENAI_DECISIONS_API_KEY=
